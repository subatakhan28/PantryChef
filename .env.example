# =============================================================================
# PantryChef — environment variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` or any file containing secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public origin used for OAuth redirect URLs and email confirmation links.
# Local: http://localhost:3000
# Prod:  https://pantrychef.app  (or your Vercel URL)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase
# Find these in: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Service role key — SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# -----------------------------------------------------------------------------
# Database (Prisma + Supabase Postgres)
# Find these in: Supabase Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL  — pooled connection (PgBouncer, port 6543) used at runtime.
#                 MUST include `?pgbouncer=true&connection_limit=1` for serverless.
# DIRECT_URL    — direct connection (port 5432) used by `prisma migrate`.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# OpenAI (recipe AI features)
# https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
